# Consilium reads the model from CONSILIUM_MODEL (or the --model flag).
# The provider prefix selects which API key below is used (via LiteLLM).
# Default model: openrouter/google/gemini-2.0-flash-001
CONSILIUM_MODEL=gemini/gemini-2.5-flash

# --- Provider keys (set the one matching your CONSILIUM_MODEL prefix) ---

# gemini/...  — Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# openrouter/...  — OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# (no prefix, e.g. claude-sonnet-4-6) — Anthropic key, uses the native SDK
ANTHROPIC_API_KEY=sk-ant-...
